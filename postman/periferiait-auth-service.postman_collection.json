{
  "info": {
    "_postman_id": "1549207c-aa0b-4e2f-9fe5-30e8ed8a9f3f",
    "name": "periferiait-auth-service",
    "description": "Colección del microservicio de autenticación (periferiait-auth-service, puerto 8081).\n\nOrden sugerido:\n1. Login  -> guarda el JWT en la variable GLOBAL `authToken` (reutilizable por el logic-service).\n2. Get Profile (usa el token).\n\nUsuarios seed (password para todos: Periferia123*): jdoe, mgarcia, crodriguez, alopez, dmartinez.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36696823"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.globals.set('authToken', res.accessToken);",
                  "  pm.collectionVariables.set('authToken', res.accessToken);",
                  "  pm.environment.set('authToken', res.accessToken);",
                  "  console.log('JWT guardado en la variable global authToken');",
                  "  pm.test('Devuelve accessToken', function () { pm.expect(res.accessToken).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Autentica un usuario y devuelve un JWT (HS256). Endpoint público."
          },
          "response": []
        }
      ]
    },
    {
      "name": "users",
      "item": [
        {
          "name": "me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/users/me",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Devuelve el perfil del usuario autenticado (requiere Bearer token)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{authBaseUrl}}/actuator/health",
          "host": [
            "{{authBaseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Estado del servicio (observabilidad)."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "username",
      "value": "jdoe"
    },
    {
      "key": "password",
      "value": "Periferia123*"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ]
}